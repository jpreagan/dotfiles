#!/bin/bash
set -euo pipefail

# homebrew
brew upgrade -y

# google cloud cli
gcloud components update

# uv tools
uv tool upgrade --all

# rust
rustup update
cargo install-update -a

# npm
npm update -g

# sparkle cli
"$HOME/.local/bin/upgrade-sparkle"

# codex
"$HOME/.local/bin/upgrade-chatgpt-desktop"
open -g -a ChatGPT

# codex cli
codex update

# claude desktop
"$HOME/.local/bin/upgrade-claude-desktop"
open -g -a Claude

# claude code
claude update

# grok
grok update

# neovim
"$HOME/.local/bin/upgrade-nvim"
