#!/bin/bash
set -euo pipefail

# homebrew
brew upgrade -y

# google cloud cli
gcloud components update

# uv tools
uv tool upgrade --all

# rust
rustup update
cargo install-update -a

# npm
npm update -g

# sparkle cli
"$HOME/.local/bin/upgrade-sparkle"

# codex desktop
"$HOME/.local/lib/codex-updater/sparkle" /Applications/ChatGPT.app \
  --check-immediately \
  --feed-url https://persistent.oaistatic.com/codex-app-prod/appcast.xml \
  --user-agent-name terminal-upgrade

# codex cli
codex update

# claude
claude update

# grok
grok update

# neovim
"$HOME/.local/bin/upgrade-nvim"
